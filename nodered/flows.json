[
  {
    "id": "tab_ecowatt_grid_guard",
    "type": "tab",
    "label": "EcoWatt Grid Guard IoT Flows",
    "disabled": false,
    "info": "Real-time MQTT telemetry, demand threshold violation alerting, and actuator acknowledgement monitoring for EcoWatt Grid Guard."
  },
  {
    "id": "mqtt_broker_local",
    "type": "mqtt-broker",
    "name": "EcoWatt Mosquitto MQTT Broker",
    "broker": "127.0.0.1",
    "port": "1883",
    "clientid": "nodered_ecowatt_monitor",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "autoUnsubscribe": true
  },
  {
    "id": "sub_demand",
    "type": "mqtt in",
    "z": "tab_ecowatt_grid_guard",
    "name": "Sub Building Demand",
    "topic": "ecowatt/building/demand",
    "qos": "1",
    "datatype": "json",
    "broker": "mqtt_broker_local",
    "nl": false,
    "rap": true,
    "rh": 0,
    "x": 180,
    "y": 120,
    "wires": [["fn_check_threshold", "debug_demand_stream"]]
  },
  {
    "id": "fn_check_threshold",
    "type": "function",
    "z": "tab_ecowatt_grid_guard",
    "name": "Demand Threshold Evaluator",
    "func": "// Check if active power exceeds threshold\nconst p = msg.payload.total_power_kw || 0;\nconst thresh = msg.payload.threshold_kw || 7.0;\nconst target = msg.payload.target_kw || 6.8;\n\nif (p > thresh) {\n    const excess = p - target;\n    msg.payload = {\n        alert: 'CRITICAL_DEMAND_EXCEEDANCE',\n        level: 'WARNING',\n        current_power_kw: p,\n        threshold_kw: thresh,\n        target_kw: target,\n        required_reduction_kw: excess,\n        timestamp: new Date().toISOString()\n    };\n    return [msg, null];\n} else {\n    msg.payload = {\n        status: 'NORMAL',\n        headroom_kw: thresh - p,\n        current_power_kw: p,\n        timestamp: new Date().toISOString()\n    };\n    return [null, msg];\n}",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 450,
    "y": 120,
    "wires": [["pub_alerts", "debug_threshold_violation"], ["debug_normal_headroom"]]
  },
  {
    "id": "pub_alerts",
    "type": "mqtt out",
    "z": "tab_ecowatt_grid_guard",
    "name": "Pub Threshold Alert",
    "topic": "ecowatt/alerts",
    "qos": "1",
    "retain": "false",
    "respTopic": "",
    "contentType": "application/json",
    "userProps": "",
    "correl": "",
    "expiry": "",
    "broker": "mqtt_broker_local",
    "x": 750,
    "y": 90,
    "wires": []
  },
  {
    "id": "sub_commands",
    "type": "mqtt in",
    "z": "tab_ecowatt_grid_guard",
    "name": "Sub Load Commands",
    "topic": "ecowatt/load/+/command",
    "qos": "1",
    "datatype": "json",
    "broker": "mqtt_broker_local",
    "nl": false,
    "rap": true,
    "rh": 0,
    "x": 170,
    "y": 240,
    "wires": [["fn_audit_critical_protection", "debug_command_stream"]]
  },
  {
    "id": "fn_audit_critical_protection",
    "type": "function",
    "z": "tab_ecowatt_grid_guard",
    "name": "Critical Load Safety Auditor",
    "func": "// Verify command does not target critical loads\nconst topic = msg.topic;\nconst parts = topic.split('/');\nconst loadId = parts[2] || '';\n\nconst criticalLoads = ['srv_it_rack_1', 'srv_it_rack_2', 'srv_cool_pri', 'cls_emerg_light', 'cor_emerg_light', 'srv_safety_sys'];\n\nif (criticalLoads.includes(loadId) && (msg.payload.action === 'CURTAIL' || msg.payload.requested_level < 1.0)) {\n    msg.payload = {\n        violation: 'SECURITY_AUDIT_FAIL',\n        load_id: loadId,\n        message: 'Critical load cannot be curtailed!',\n        timestamp: new Date().toISOString()\n    };\n    return [msg, null];\n}\n\nreturn [null, msg];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 440,
    "y": 240,
    "wires": [["debug_audit_violation"], ["debug_audited_command"]]
  },
  {
    "id": "sub_acks",
    "type": "mqtt in",
    "z": "tab_ecowatt_grid_guard",
    "name": "Sub Actuator Acks",
    "topic": "ecowatt/load/+/ack",
    "qos": "1",
    "datatype": "json",
    "broker": "mqtt_broker_local",
    "nl": false,
    "rap": true,
    "rh": 0,
    "x": 160,
    "y": 340,
    "wires": [["fn_ack_latency_tracker", "debug_ack_stream"]]
  },
  {
    "id": "fn_ack_latency_tracker",
    "type": "function",
    "z": "tab_ecowatt_grid_guard",
    "name": "Ack Latency & Health Tracker",
    "func": "const ack = msg.payload;\nmsg.payload = {\n    load_id: ack.load_id,\n    status: ack.status,\n    actual_power_kw: ack.actual_power_kw,\n    latency_ms: ack.latency_ms || 40.0,\n    received_at: new Date().toISOString()\n};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 450,
    "y": 340,
    "wires": [["debug_ack_latency"]]
  },
  {
