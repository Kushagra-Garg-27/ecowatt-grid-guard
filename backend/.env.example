# EcoWatt Grid Guard Environment Variables
ENVIRONMENT=development
DEBUG=true

# Server
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/ecowatt.db

# CoAP Configuration
COAP_HOST=127.0.0.1
COAP_PORT=5683

# MQTT Configuration
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_KEEP_ALIVE=60
MQTT_QOS=1
MQTT_EMBEDDED_BROKER=true

# Optimization Thresholds
DEFAULT_DEMAND_THRESHOLD_KW=7.00
DEFAULT_RESERVE_MARGIN_KW=0.20

# LPS Weights (Sum must equal 1.0)
WEIGHT_SUITABILITY=0.40
WEIGHT_OCCUPANCY=0.20
WEIGHT_POWER=0.20
WEIGHT_TARIFF=0.20

# Simulation Configuration
DEFAULT_INTERVAL_MINUTES=15
SIMULATION_RANDOM_SEED=42

